{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glacier-EQ",
  "version": "0.5.0",
  "identifier": "com.bukutsu.glaciereq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glacier EQ",
        "label": "main",
        "width": 1340,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
