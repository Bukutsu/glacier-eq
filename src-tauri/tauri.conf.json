{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glacier-EQ",
  "version": "0.15.0",
  "identifier": "com.bukutsu.glaciereq",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Glacier EQ",
        "label": "main",
        "width": 1340,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://raw.githubusercontent.com; img-src 'self' data: asset: https://asset.localhost https://bukutsu.github.io; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MTFDOTBFODI2NEI3ODAKUldTQXQyU0NEc2tSbFA2a0x4dVJqbzN4T1FBaFM1MHB4T1Y0ZnhYdnJ2emdUdFpNeVVTY3NYUkQK",
      "endpoints": [
        "https://github.com/Bukutsu/glacier-eq/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": ["deb", "rpm"],
    "linux": {
      "appimage": {
        "files": {
          "usr/share/metainfo/com.bukutsu.glaciereq.metainfo.xml": "../desktop/com.bukutsu.glaciereq.metainfo.xml"
        }
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
