{
  "name": "glacier-eq",
  "private": true,
  "version": "0.6.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run wasm:build && vite --mode web",
    "dev:desktop": "vite --mode desktop",
    "wasm:build": "cross-env RUSTFLAGS= wasm-pack build glacier-core --target web --out-dir ../src/wasm_pkg",
    "build": "npm run build:web",
    "build:web": "npm run wasm:build && tsc -p tsconfig.web.json && vite build --mode web",
    "build:desktop": "tsc -p tsconfig.desktop.json && vite build --mode desktop",
    "test": "vitest run",
    "tauri": "tauri",
    "android:doctor": "tauri info",
    "android:init": "tauri android init --ci",
    "android:dev": "tauri android dev",
    "android:run": "tauri android run",
    "android:apk": "tauri android build --debug --apk --target aarch64",
    "android:apk:release": "tauri android build --apk --target aarch64",
    "android:apk:split": "tauri android build --apk --split-per-abi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wasm-pack": "^0.15.0"
  }
}
