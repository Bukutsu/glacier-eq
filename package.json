{
  "name": "glacier-eq",
  "private": true,
  "version": "0.2.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm:build": "wasm-pack build --target web --out-dir ../src/wasm_pkg glacier-core",
    "prebuild": "npm run wasm:build",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "android:doctor": "bash scripts/android-doctor.sh",
    "android:init": "tauri android init --ci",
    "android:dev": "tauri android dev",
    "android:run": "tauri android run",
    "android:apk": "tauri android build --debug --apk --target aarch64",
    "android:apk:release": "tauri android build --apk --target aarch64",
    "android:apk:split": "tauri android build --apk --split-per-abi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tauri-plugin-m3": "^0.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "wasm-pack": "^0.15.0"
  }
}
